{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Harness QA Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobId", "qa", "commitSha", "decision", "evaluatedAt", "commands", "baselineFailures"],
  "properties": {
    "jobId": { "type": "string", "pattern": "^JOB-[A-Z0-9]+(?:-[A-Z0-9]+)*$" },
    "qa": { "const": "qa" },
    "commitSha": { "type": "string", "minLength": 7 },
    "decision": { "enum": ["pass", "fail"] },
    "evaluatedAt": { "type": "string", "format": "date-time" },
    "commands": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["command", "startedAt", "exitCode", "output"], "properties": { "command": { "type": "string" }, "startedAt": { "type": "string", "format": "date-time" }, "exitCode": { "type": "integer" }, "output": { "type": "string" } } } },
    "baselineFailures": { "type": "array", "items": { "type": "string" } }
  }
}
